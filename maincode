void pageNewSimulations(char& option, int& numberOfSims) {//auto returns
    string simName;
    system("cls");
    option = '0';
    cout << "########################################################################\n";
    cout << "#                                                                      #\n";
    cout << "#                         +==================+                         #\n";
    cout << "#                         || New Simulation ||                         #\n";
    cout << "#                         +==================+                         #\n";
    cout << "#                                                                      #\n";
    cout << "########################################################################\n";
    cout << "Enter the name of your new simulation\nMax 50 characters\nEnter \"x\" to exit\n";
    getline(cin, simName);
    if (simName == "x" || simName == "X") {nextPage = 1; return;}
    else {
        numberOfSims++;
        simulationName[numberOfSims] = simName;
        nextPage = 1;
        return;
    }

}

void pageExistingSimulations(char& option, int& currentSimulation) {
    system("cls");
    option = '0';
    currentSimulation = 0;
    cout << "########################################################################\n";
    cout << "#                                                                      #\n";
    cout << "#                          +===============+                           #\n";
    cout << "#                          || Simulations ||                           #\n";
    cout << "#                          +===============+                           #\n";
    cout << "#                                                                      #\n";
    for (int i = 0; i < maxThings; i++) {
        if (simulationName[i] == " ") {cout << "#                                                                      #\n";}
        else {cout << "#       " << i + 1 << "." << fillSpaces(simulationName[i],63) << "#\n";}
    }
    for (int i = 0; i < (16 - maxThings - 4); i++) {cout << "#                                                                      #\n";}
    cout << "#       +---+------------------+                                       #\n";
    cout << "#       | X | Back             |                                       #\n";
    cout << "#       +---+------------------+                                       #\n";
    cout << "#                                                                      #\n";
    cout << "########################################################################\n";
    while (true) {
        if (_kbhit()) {
            char key = tolower(_getch());
            if (key == 'x') {
                option = key;
                nextPage = 1;
                return;
            }
            else if (key >= '0' && key <= '9' && key - '0' <= maxThings && key - '0'  > 0) {
                currentSimulation = key - '0';
                nextPage = 3;
                return;
            }
            break;
        }
    }
}

void pageSimulation(char& option, int simulation, int& currentProfile) {
    system("cls");
    option = '0';
    currentProfile = 0;
    string simName = fillspaces(simulationName[simulation], 44);
    cout << "########################################################################\n";
    cout << "#    ||  Simulation: " << simName << "||    #\n";
    cout << "########################################################################\n";
    cout << "#                                                                      #\n";
    cout << "#       +---+------------------+        +---+------------------+       #\n";
    cout << "#       | V | View Stock Price |        | N | New Profile      |       #\n";
    cout << "#       +---+------------------+        +---+------------------+       #\n";
    cout << "#                                                                      #\n";
    for (int i = 0; i < maxThings; i++) {
        if (profileName[i] == " ") {cout << "#                                                                      #\n";}
        else {cout << "#       " << i + 1 << "." << fillSpaces(profileName[i],63) << "#\n";}
    }
    cout << "#                                                                      #\n";
    cout << "#       +---+------------------+        +---+------------------+       #\n";
    cout << "#       | X | Back             |        | S | Settings         |       #\n";
    cout << "#       +---+------------------+        +---+------------------+       #\n";
    cout << "#                                                                      #\n";
    cout << "########################################################################\n";
    while (true) {
        if (_kbhit()) {
            char key = tolower(_getch());
            switch (key) {
                case 'x': option = key; nextPage = 2; return;
                case 'v':
                case 'n':
                case 's': option = key; nextPage = 4; return;
            }
            if (key >= '0' && key <= '9' && key - '0' <= maxThings && key - '0'  > 0) {
                currentProfile = key - '0';
                nextPage = 5;
                return;
            }
            break;
        }
    }
}

