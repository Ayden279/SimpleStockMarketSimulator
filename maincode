using namespace std;

string fillspaces(string text, int finalLength);
void pageHome(char& option);
void pageNewSimulations(char& option, int& numberOfSims);
void pageExistingSimulations(char& option, int& currentSimulation);
void pageSimulation(char& option, int currentSimulation, int& currentProfile);
void pageStockPrices(char& option, int currentSimulation);
void pageNewProfile(char& option, int currentSimulation, int& numberOfProfiles);
void pageSettings(char& option, int currentSimulation);
void pageProfile(char& option, int currentSimulation, int currentProfile);

const int maxThings = 9;

// if imbalance, offset to left
char option; //in lowercase, always set to 0 at start of funtion
int nextPage = 1;
//home

//simulations
    int simulationNumber[maxThings];
    string simulationName[maxThings];
    int numberOfSims;
    int currentSimulation;

//profiles
    int profileNumber[maxThings];
    string profileName[maxThings];
    int numberOfProfiles;
    int currentProfile;


int main() {
    bool noQuit = true;
    
    for (int i = 0; i < maxThings; i++) {
        simulationNumber[i] = i;
        simulationName[i] = " ";
        profileNumber[i] = i;
        profileName[i] = " ";
    }
    numberOfSims = 0;
    numberOfProfiles = 0;


    while(noQuit){
        switch (nextPage) {
            case 1: pageHome(option); break;
            case 2: if (option == 'n') {pageNewSimulations(option, numberOfSims); break;}
                    else if (option == 's' || option == 'x') {pageExistingSimulations(option, currentSimulation); break;}
            case 3: pageSimulation(option, currentSimulation, currentProfile); break;
            case 4: switch (option) {                
                        case 'v': pageStockPrices(option, currentSimulation); break;
                        case 'n': pageNewProfile(option, currentSimulation, numberOfProfiles); break;
                        case 's': pageSettings(option, currentSimulation); break;
                    }
            case 5: pageProfile(option, currentSimulation, currentProfile); break;
             
        }

    }

    cin.ignore(10000,'\n');
    cin.get();
    return 0;
}    

string fillSpaces(string text, int finalLength) { //assume length of text is less than final length
    string newString;
    newString = text;
    for (int i = text.length(); i < finalLength; i++) {
        newString = newString + ' ';
    }
    return newString;
}

